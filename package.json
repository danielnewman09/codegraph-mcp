{
  "name": "codegraph",
  "version": "0.1.0",
  "description": "Pi extension wrapping the codegraph + doxygen-index libraries — a portable single package that bootstraps its own Python env, generates project config, manages a project-local Neo4j Docker container, indexes source into the graph, and retrieves rich knowledge-graph context via a narrow 3-tool surface (with interactive HTML neighborhood visualization).",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Newman",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codegraph",
    "neo4j",
    "knowledge-graph",
    "codebase-context",
    "retrieval"
  ],
  "main": "index.ts",
  "bin": {
    "codegraph-mcp": "./dist/codex-mcp.js"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "shared.ts",
    "tools",
    "src",
    "bridge",
    "dist",
    ".codex-plugin",
    ".mcp.json",
    "skills",
    "README.md",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "esbuild src/harnesses/mcp.ts --bundle --platform=node --format=esm --outfile=dist/codex-mcp.js --banner:js=\"#!/usr/bin/env node\"",
    "test": "node --import tsx --test \"tests/core/*.test.ts\" \"tests/mcp/*.test.ts\" \"tests/package/*.test.ts\" \"tests/plugin/*.test.ts\"",
    "test:mcp": "node --import tsx --test \"tests/mcp/*.test.ts\"",
    "test:pi": "tsx stub.test.ts",
    "bridge:check": "python3 -c \"import ast; ast.parse(open('bridge/codegraph_bridge.py').read()); print('bridge syntax OK')\"",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "pack:check": "npm run build && node tests/package/check-pack.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typebox": "^1.1.24"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
